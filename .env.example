# Copy this file to .env and adjust the values.

# --- IP cameras (referenced in go2rtc/go2rtc.yaml) ---
CAMERA1_URL=rtsp://<user>:<password>@192.168.1.101:554/stream1
CAMERA2_URL=rtsp://<user>:<password>@192.168.1.102:554/stream1

# LAN/public IP of the docker host for WebRTC (leave as "stun" to auto-detect)
WEBRTC_CANDIDATE=stun

# --- Published ports ---
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555
DASHBOARD_PORT=8080

# --- Web page capture (dashboard page -> go2rtc "dashboard" stream) ---
CAPTURE_URL=http://dashboard/?mode=mse
CAPTURE_RTSP_TARGET=rtsp://go2rtc:8554/dashboard
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
CAPTURE_FRAMERATE=15
CAPTURE_BITRATE=4M
